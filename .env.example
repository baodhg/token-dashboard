# ── Local dashboard database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/token_dashboard?schema=public"

# ── Global race server ────────────────────────────────────────────────────────
# URL of the deployed race-server. Leave empty to disable race features.
# Must match the PORT in race-server/.env (default 9876).
NEXT_PUBLIC_RACE_SERVER_URL=http://your-server-ip:9876

# Race identity — dashboard auto-registers and reports tokens on every sync.
# No manual steps needed: just set these and run the dashboard.
RACE_PLAYER_NAME=your-name
RACE_PLAYER_PASSWORD=your-password

# Competition window. All players must use the same value to compete fairly.
# Options: 1d (today from midnight) | 3d | 1w | 1m | all
RACE_PERIOD=1d
