# Copy this file to .env and fill in your values:  cp .env.example .env
#
# Running with Docker? See the "Run with Docker" section in README.md. Most values
# below are only needed for specific features — the bundled-db Docker mode works
# with this file mostly left at defaults.

# ── Dashboard database ────────────────────────────────────────────────────────
# Used when running the app directly on your machine (npm run dev / start).
DATABASE_URL="postgresql://postgres:password@localhost:5432/token_dashboard?schema=public"

# Used ONLY when running the app in Docker against your OWN host PostgreSQL.
# A container's "localhost" is the container itself, so the host must be
# host.docker.internal. Leave UNSET to use the bundled db (`--profile bundled`).
# DATABASE_URL_DOCKER="postgresql://postgres:password@host.docker.internal:5432/token_dashboard?schema=public"

# ── Host log locations (Docker sync) ──────────────────────────────────────────
# The Dockerized app reads your AI-tool logs from the host. HOST_HOME defaults to
# the Windows %USERPROFILE%. On macOS/Linux, set both of these:
#   macOS:   HOST_HOME=/Users/you      VSCODE_USER_DIR=/Users/you/Library/Application Support/Code/User
#   Linux:   HOST_HOME=/home/you       VSCODE_USER_DIR=/home/you/.config/Code/User
# HOST_HOME=/Users/you
# VSCODE_USER_DIR=/Users/you/Library/Application Support/Code/User

# ── Race server ───────────────────────────────────────────────────────────────
# URL of the race-server as seen by the BROWSER. Leave empty to disable race UI.
# Default for Docker is http://localhost:9876 (the published race-server port).
NEXT_PUBLIC_RACE_SERVER_URL=http://localhost:9876
# Server-side race URL. In Docker the app reaches the race-server by service name;
# only set this to override the default http://race-server:9876.
# RACE_SERVER_URL_DOCKER=http://race-server:9876

# Race identity. This machine auto-races under this name on every sync.
# Leave empty to disable race reporting.
RACE_PLAYER_NAME=your-name
RACE_PLAYER_PASSWORD=your-password
# Competition window: 1d | 3d | 1w | 1m | all  (all players must match to compete)
RACE_PERIOD=1d

# ── Race-server backend (Docker) ──────────────────────────────────────────────
# DB the race-server writes to. When UNSET it follows the app: DATABASE_URL_DOCKER
# if you set one, otherwise the bundled db. Set this only to use a SEPARATE/remote
# race database (e.g. a shared leaderboard).
# RACE_SERVER_DATABASE_URL=postgres://user:pass@your-race-db-host:5432/token_dashboard
JWT_SECRET=change-me-in-production
ADMIN_KEY=admin
# ALLOWED_ORIGINS=*

# ── Bundled database (only used with `--profile bundled`) ─────────────────────
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=token_dashboard

# ── Published ports (optional) ────────────────────────────────────────────────
# APP_PORT=3000
# RACE_PORT=9876

# ── Timezone (Docker) ─────────────────────────────────────────────────────────
# Chart hour/day buckets use the container's local time. Defaults to
# Asia/Ho_Chi_Minh (UTC+7); set this to your IANA zone if you're elsewhere.
# TZ=Asia/Ho_Chi_Minh
