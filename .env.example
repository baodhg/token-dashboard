# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/token_dashboard?schema=public"

# Multiplayer race server URL (Socket.io).
# Set to your deployed server address, e.g. http://your-server-ip:3001
# Leave empty to disable the Global Race feature.
NEXT_PUBLIC_RACE_SERVER_URL=http://localhost:3001

# JWT token for server-side race reporting (obtained after logging in at /race).
# Copy the token from browser sessionStorage key "race_session" → token field.
# When set, every sync run pushes your totalTokens to the race server immediately.
RACE_PLAYER_TOKEN=
