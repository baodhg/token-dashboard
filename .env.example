# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/token_dashboard?schema=public"

# Multiplayer race server URL (Socket.io).
# Set to your deployed server address, e.g. http://your-server-ip:3001
# Leave empty to disable the Global Race feature.
NEXT_PUBLIC_RACE_SERVER_URL=http://localhost:3001

# Race identity — set these to join the global race automatically.
# The dashboard will auto-register / login on first sync, no manual steps needed.
# If the account doesn't exist yet, it will be created automatically.
RACE_PLAYER_NAME=your-name
RACE_PLAYER_PASSWORD=your-password
# Race period: 1d (today) | 3d | 1w | 1m | all. All players must use same value.
RACE_PERIOD=1d
