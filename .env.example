# ── Local dashboard database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/token_dashboard?schema=public"

# ── Global race server ────────────────────────────────────────────────────────
# URL of the deployed race-server. Leave empty to disable race features.
# Must match the PORT in race-server/.env (default 9876).
NEXT_PUBLIC_RACE_SERVER_URL=http://your-server-ip:9876
# Same URL without NEXT_PUBLIC_ prefix — needed for server-side reporting
RACE_SERVER_URL=http://your-server-ip:9876

# ── Race identity (THE racer) ─────────────────────────────────────────────────
# This machine auto-races in the background under this name on every sync — no
# browser or login required. This is the single source of truth for identity.
# To VIEW the race at /race you must log in, and the login is locked to this
# exact name (the name field is pre-filled and read-only) — only the password
# is entered. The account is auto-created on first sync.
RACE_PLAYER_NAME=your-name
RACE_PLAYER_PASSWORD=your-password

# Competition window. All players must use the same value to compete fairly.
# Options: 1d (today from midnight) | 3d | 1w | 1m | all
RACE_PERIOD=1d
