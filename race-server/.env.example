# Port the server listens on
PORT=3001

# Comma-separated list of allowed CORS origins.
# Use "*" to allow all (fine for LAN/private), or restrict to your dashboard URL.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://your-dashboard.com
ALLOWED_ORIGINS=*

# Secret used to sign JWT tokens. Change this to a long random string before deploying.
# If not set, a random secret is generated on startup (tokens invalidate on restart).
JWT_SECRET=change-me-to-a-long-random-string

# Admin key for the /race/admin panel. Change before deploying.
ADMIN_KEY=change-me-admin-key

# PostgreSQL connection string — race-server's own DB (users + race_snapshots).
# When using docker-compose, this points to the bundled postgres service.
# For local dev: create a local DB named racedb, or use any available PostgreSQL.
DATABASE_URL=postgresql://race:change-me-db-password@localhost:5432/racedb
