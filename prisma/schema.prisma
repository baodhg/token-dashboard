generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Call {
  id           String   @id           // requestId
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheTokens  Int      @default(0)
  cost         Float    @default(0)
  timestamp    DateTime
  sessionId    String?
  project      String?

  @@index([timestamp])
  @@index([model])
  @@map("calls")
}

model SyncState {
  filePath     String   @id
  lastSize     BigInt   @default(0)
  lastSyncedAt DateTime @default(now()) @updatedAt

  @@map("sync_state")
}
