generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Call {
  id              String   @id           // requestId
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheTokens         Int      @default(0)
  cacheCreationTokens Int      @default(0)
  cost                Float    @default(0)
  unitPriceInput  Float    @default(0)   // Price per 1M tokens at time of call
  unitPriceOutput Float    @default(0)   // Price per 1M tokens at time of call
  priceMetadata   String?                // e.g., "gemini-1.5-pro-paid-v1"
  timestamp       DateTime
  sessionId       String?
  project         String?
  source          String   @default("claude_code")

  @@index([timestamp])
  @@index([model])
  @@index([source])
  @@map("calls")
}

model PriceConfig {
  id              String   @id @default(uuid())
  source          String   // e.g., "gemini", "codex", "claude_code"
  modelPattern    String   // e.g., "pro", "flash", "opus", "*"
  unitPriceInput  Float
  unitPriceOutput Float
  unitPriceCache  Float    @default(0)
  unitPriceCacheWrite Float @default(0)
  version         String   // e.g., "2024-v1"
  isCurrent       Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@map("price_configs")
}

model SyncState {
  filePath     String   @id
  lastSize     BigInt   @default(0)
  lastSyncedAt DateTime @default(now()) @updatedAt

  @@map("sync_state")
}

// Rocket shop (skins/colors/wallet) now lives on the SHARED race-server DB
// (race_shop_profiles / race_purchases), so every player and spectator sees the
// same ship. The old per-machine RocketProfile model + /api/rocket-profile route
// were removed; lib/rocket-config.ts (localStorage) is kept only as an instant
// preview cache for the current player.

model DailyBalance {
  date        String
  model       String
  source      String
  dailyCost   Float  @default(0)
  dailyTokens Int    @default(0)

  @@id([date, model, source])
  @@map("daily_balances")
}
